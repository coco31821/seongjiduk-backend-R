# docker-compose.prod.yml 환경변수 예시 — 복사해서 .env로 사용 (커밋 금지)
DOMAIN=example.com            # 로컬 검증은 :80

MYSQL_DATABASE=seongjiduk
MYSQL_USER=seongjiduk
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

JWT_SECRET=change-me-at-least-32-bytes-long-secret

# AI (비우면 mock으로 동작)
OPENAI_API_KEY=
AI_MODEL=gpt-4o

# 선택
GOOGLE_MAPS_API_KEY=
GRAFANA_ADMIN_PASSWORD=change-me

# 이미지 오버라이드 (기본 ghcr latest)
#BACKEND_IMAGE=ghcr.io/sungjiduk/seongjiduk-backend:latest
#AI_IMAGE=ghcr.io/sungjiduk/seongjiduk-ai:latest
#FRONTEND_IMAGE=ghcr.io/sungjiduk/seongjiduk-frontend:latest
